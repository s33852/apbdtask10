@inherits LayoutComponentBase
@inject ObservedStudentsState ObservedState
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Student Panel</span>
            <NavLink href="observed" class="badge bg-warning text-dark text-decoration-none">
                <i class="bi bi-eye-fill me-1"></i>Observed: @ObservedState.Count
            </NavLink>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#10006;</span>
</div>

@code {
    protected override void OnInitialized()
    {
        ObservedState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ObservedState.OnChange -= StateHasChanged;
    }
}
